{
  "name": "@intake/landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p . && tsc -p tsconfig.server.json",
    "db:generate": "auth generate --config server/auth.ts --output db/auth.sql --yes",
    "db:migrate": "auth migrate --config server/auth.ts --yes",
    "db:migrate:intake": "tsx db/migrate.ts",
    "test": "tsx --test test/*.test.mjs",
    "dev:api": "tsx watch server/index.ts",
    "pretest": "vite build",
    "preflight": "tsx server/preflight.ts",
    "verify:production": "node tools/verify-production.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "better-auth": "1.7.6",
    "dotenv": "^18.0.4",
    "express": "^4.22.3",
    "motion": "^13.4.4",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "auth": "1.7.6",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": "22.x"
  }
}
