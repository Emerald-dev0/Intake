# Absolute URL of the deployed site, used for canonical + social preview tags.
# On Vercel this is picked up automatically; set it for custom domains.
VITE_SITE_URL=https://intake.example.com

# Waitlist: where the email box posts to (form-encoded, no-cors).
# Easiest option: a Google Form with one "Email" short-answer question.
#   VITE_WAITLIST_URL   = https://docs.google.com/forms/d/e/<FORM_ID>/formResponse
#   VITE_WAITLIST_FIELD = entry.<ENTRY_ID>   (from "Get pre-filled link")
# Formspree / Basin / Getform also work: use their endpoint and field "email".
VITE_WAITLIST_URL=
VITE_WAITLIST_FIELD=email
