# Same Neon PostgreSQL database for Better Auth now and Intake data later.
# Obtain the connection string in the Neon dashboard; include sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Generate a unique value of at least 32 random characters, e.g. openssl rand -base64 32.
BETTER_AUTH_SECRET=
# Exact public origin (scheme + host + optional port), no trailing slash.
# For a cloud preview set this to its HTTPS preview origin, not localhost.
BETTER_AUTH_URL=http://localhost:5173
PORT=3001

# Vite dev/preview proxy target; never embedded in browser JavaScript.
API_PROXY_TARGET=http://127.0.0.1:3001

# Vercel routing only: actual HTTPS Render origin, no trailing slash.
# Set this in the Vercel dashboard, not as a VITE_ variable.
BACKEND_URL=

# Landing page only: canonical/social URL and optional legacy waitlist endpoint.
VITE_SITE_URL=
VITE_WAITLIST_URL=
VITE_WAITLIST_FIELD=email

# Provider authorization. Separate from Intake sign-in — leave blank until real
# credentials exist. Blank means "not configured"; the app will not fake a connection.
# Register these exact redirect URIs (no trailing slash on BETTER_AUTH_URL):
#   ${BETTER_AUTH_URL}/api/providers/google/callback
#   ${BETTER_AUTH_URL}/api/providers/microsoft/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Optional. common (default), organizations, consumers, or a tenant GUID.
# MICROSOFT_OAUTH_TENANT=common
# Optional. 32+ random bytes, e.g. openssl rand -base64 32.
# If unset, provider tokens are encrypted with a key derived from BETTER_AUTH_SECRET.
# Set this before production so rotating the auth secret does not invalidate connections.
# PROVIDER_TOKEN_KEY=

# Server-side natural-language interpretation. Obtain a key from the OpenAI API dashboard.
# Blank means live interpretation returns model_not_configured; no fake specification is created.
# Required only for live interpretation, not for npm test or building the frontend.
# Set on the API service (Render), NEVER as a VITE_ variable or on the public frontend.
OPENAI_API_KEY=
# Optional structured-output-capable model. Default: gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini
