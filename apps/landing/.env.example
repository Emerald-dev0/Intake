# Same Neon PostgreSQL database for Better Auth now and Intake data later.
# Obtain the connection string in the Neon dashboard; include sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Generate a unique value of at least 32 random characters, e.g. openssl rand -base64 32.
BETTER_AUTH_SECRET=
# Exact public origin (scheme + host + optional port), no trailing slash.
# For a cloud preview set this to its HTTPS preview origin, not localhost.
BETTER_AUTH_URL=http://localhost:5173
PORT=3001
# Number of known reverse-proxy hops trusted when deriving client network addresses (0-4).
# Keep 0 locally. Verify the deployed Vercel/Render forwarding chain before changing this;
# trusting too many hops permits spoofing, while too few can group users under a proxy address.
API_TRUST_PROXY_HOPS=0

# Server-only comma-separated exact email allowlist for /admin. Leave empty to deny all admin access.
# The Better Auth user must exist and have emailVerified=true; this checkout has no email delivery service.
# Never use a VITE_ prefix; authorization is checked against the current database user on the API.
ADMIN_EMAILS=

# Vite dev/preview proxy target; never embedded in browser JavaScript.
API_PROXY_TARGET=http://127.0.0.1:3001

# Vercel routing only: actual HTTPS Render origin, no trailing slash.
# Set this in the Vercel dashboard, not as a VITE_ variable.
BACKEND_URL=

# Canonical public origin for the built frontend: canonical link, Open Graph URL, Schema.org ids,
# robots.txt and sitemap.xml. Optional; when unset the build uses the documented default in
# src/lib/site-url.ts. Set it in the Vercel project environment when the site is served from a
# custom domain (for example https://intake.example.com). Public value only, no secrets, and it must
# be an exact lowercase https origin with no path or trailing slash.
# Keep it equal to the origin users actually open, and keep the API's BETTER_AUTH_URL on that same
# origin: BETTER_AUTH_URL is the auth/CSRF/OAuth-callback origin and may differ only if you also
# configure the proxy to serve cookies for it.
# VITE_SITE_URL=https://intake.example.com

# Optional legacy waitlist endpoint. VITE_ values are public browser configuration.
VITE_WAITLIST_URL=
VITE_WAITLIST_FIELD=email

# Google SIGN-IN (authentication: "Continue with Google"). Identity only: no Forms scope,
# no provider connection, no access to the user's forms.
# Register this exact redirect URI on the sign-in OAuth client:
#   ${BETTER_AUTH_URL}/api/auth/callback/google
# Leave BOTH blank to disable Google sign-in; the UI then hides the button. Setting only one is
# a startup error on purpose. These credentials belong on the API service (Render) only and must
# never be a VITE_ variable. Use a DIFFERENT Google Cloud client than the Forms connection below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Provider authorization (Google Forms / Microsoft). Separate from Intake sign-in — leave blank
# until real credentials exist. Blank means "not configured"; the app will not fake a connection.
# Register these exact redirect URIs (no trailing slash on BETTER_AUTH_URL):
#   ${BETTER_AUTH_URL}/api/providers/google/callback
#   ${BETTER_AUTH_URL}/api/providers/microsoft/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Optional. common (default), organizations, consumers, or a tenant GUID.
# MICROSOFT_OAUTH_TENANT=common
# Optional. 32+ random bytes, e.g. openssl rand -base64 32.
# If unset, provider tokens are encrypted with a key derived from BETTER_AUTH_SECRET.
# Set this before production so rotating the auth secret does not invalidate connections.
# PROVIDER_TOKEN_KEY=

# ---------------------------------------------------------------------------
# Billing — Bachs payment provider (server-side only)
# ---------------------------------------------------------------------------
# Bachs handles subscription and credit-pack payments. All values are server-only:
# never give a BACHS_* value a VITE_ prefix (preflight fails the deployment if you do).
#
# Leave BACHS_API_KEY blank and billing stays inert: checkout endpoints return an error,
# and the pricing page still displays plans for information purposes only.
BACHS_API_KEY=
# Optional. Default: https://api.bachs.io
# BACHS_BASE_URL=https://api.bachs.io
# Webhook signing secret. Without it, payment webhooks are rejected and subscriptions/credit packs
# are never confirmed. Endpoint: ${BETTER_AUTH_URL}/api/webhooks/bachs
BACHS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Transactional email — Calder (server-side only)
# ---------------------------------------------------------------------------
# Calder is Intake's transactional email infrastructure. Every variable below is server-only:
# never give a CALDER_* value a VITE_ prefix (preflight fails the deployment if you do).
# Create separate Calder projects/keys for development, staging and production.
#
#   development  calder_sk_test_…  — simulated delivery, nothing reaches an inbox
#   staging      calder_sk_test_…  — simulated delivery on the real integration
#   production   calder_sk_live_…  — real delivery from a verified sending domain
#
# Leave CALDER_API_KEY blank and email stays inert: verification, password reset, welcome and
# security emails are skipped, and the UI says delivery is unavailable instead of pretending.
CALDER_API_KEY=
# Optional. Default: https://api.calder.click
# CALDER_BASE_URL=https://api.calder.click
# Address every Intake email is sent from. Must be on a domain verified in Calder
# (ownership TXT + SPF/DKIM/DMARC). Exactly one of CALDER_FROM_EMAIL or CALDER_SENDER_ID is needed.
CALDER_FROM_EMAIL=
# Optional display name, e.g. "Intake".
# CALDER_FROM_NAME=Intake
# Optional pre-created Calder sender identity (sender_…). When set it wins: Calder resolves the
# address and display name from the identity, so CALDER_FROM_EMAIL is unnecessary.
# CALDER_SENDER_ID=
# Optional reply-to address for support replies.
# CALDER_REPLY_TO=
# Optional. Larger caps only if you have a measured reason; the default 10s bounds every request.
# EMAIL_TIMEOUT_MS=10000
# EMAIL_MAX_ATTEMPTS=3
# Webhook signing secret (whsec_…) shown once when the endpoint is registered in Calder.
# Without it, delivery/bounce/complaint webhooks are rejected and suppressions never update.
# Endpoint: ${BETTER_AUTH_URL}/api/webhooks/calder
CALDER_WEBHOOK_SECRET=
# Optional. Use `memory` in tests only (it records email in process memory and delivers nothing).
# EMAIL_PROVIDER=calder
# Optional. Publish templates in Calder and pass aliases instead of Intake-rendered HTML, e.g.
# CALDER_TEMPLATE_OTP=intake-otp. Intake always renders its own copy, so a missing template
# never blocks an authentication email.
# CALDER_TEMPLATE_OTP=
# CALDER_TEMPLATE_PASSWORD_RESET=
# CALDER_TEMPLATE_WELCOME=

# ---------------------------------------------------------------------------
# AI provider (server-side interpretation only)
# ---------------------------------------------------------------------------
# Groq is the primary provider. Blank GROQ_API_KEY means live interpretation returns
# model_not_configured; no fake specification is ever created and no user is charged.
# Set these on the API service (Render), NEVER as VITE_ variables or on the public frontend.
GROQ_API_KEY=
# Optional. Default: openai/gpt-oss-120b (Groq's strict JSON-schema model).
# GROQ_MODEL=openai/gpt-oss-120b
# Optional reasoning budget for slower/cheaper calls: low, medium, high.
# GROQ_REASONING_EFFORT=low

# Optional provider choice. Unset = groq when GROQ_API_KEY exists, else openai when
# OPENAI_API_KEY exists, else not configured. There is no request-time failover between vendors.
# AI_PROVIDER=groq
# Optional structured-output ceiling per model call (256-32768). Default: 6000.
# AI_MAX_COMPLETION_TOKENS=6000

# Legacy/alternate provider. Only used when AI_PROVIDER=openai or when it is the only credential.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
