# Same Neon PostgreSQL database for Better Auth now and Intake data later.
# Obtain the connection string in the Neon dashboard; include sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Generate a unique value of at least 32 random characters, e.g. openssl rand -base64 32.
BETTER_AUTH_SECRET=
# Exact public origin (scheme + host + optional port), no trailing slash.
# For a cloud preview set this to its HTTPS preview origin, not localhost.
BETTER_AUTH_URL=http://localhost:5173
PORT=5173

# Landing page only: canonical/social URL and optional legacy waitlist endpoint.
VITE_SITE_URL=
VITE_WAITLIST_URL=
VITE_WAITLIST_FIELD=email
