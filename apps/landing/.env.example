# Intake API environment. Copy to `.env` for local development; never commit real values.
# Empty or placeholder values mean "not configured" — Intake hides the affected feature rather than
# inventing a connection, a form, or a model response. See PRODUCTION.md and LAUNCH.md for the
# production rules (TLS, exact origins, callback URIs, and the single-instance token-refresh caveat).

# ── Core ──────────────────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://user:password@localhost:5432/intake
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:5173
# Render terminates TLS one hop away. Set to the verified number of trusted proxy hops (0 in dev).
API_TRUST_PROXY_HOPS=0
# Strongly recommended in production: a dedicated 32+ byte key so rotating BETTER_AUTH_SECRET does
# not invalidate every stored provider grant.
# PROVIDER_TOKEN_KEY=

# ── AI interpretation (server-only; never prefix with VITE_) ─────────────────────────────────────
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=low            # low | medium | high
# AI_PROVIDER=groq                     # groq | openai; no request-time failover
# AI_MAX_COMPLETION_TOKENS=6000        # 256–32768

# ── Google Forms connection (a Forms OAuth client, separate from sign-in) ────────────────────────
# Redirect URI: ${BETTER_AUTH_URL}/api/providers/google/callback
# Scope: https://www.googleapis.com/auth/forms.body (sensitive: unverified apps are capped at 100
# users with 7-day refresh tokens)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Typeform connection (optional creation target) ───────────────────────────────────────────────
# Create the app in the Typeform admin panel: organization menu → Developer Apps → Register a new app.
# Redirect URI: ${BETTER_AUTH_URL}/api/providers/typeform/callback
# Scopes requested: accounts:read (identify the account), forms:read (import/inspect),
# forms:write (create), offline (required by Typeform to issue a refresh token — without it the
# connection dies when the one-week access token expires).
# ── Intake email identity ────────────────────────────────────────────────────────────────────────
# Public origin serving /brand/intake-mark.png. The logo must be fetchable by a mail client, so it
# cannot be a relative path; defaults to VITE_SITE_URL.
INTAKE_ASSET_BASE_URL=
# The Intake account on X. Every email carries it in the footer. Unset = no social row (never a
# broken link). Must be an x.com/twitter.com profile URL, e.g. https://x.com/intake.
INTAKE_X_URL=
# ── The three senders ────────────────────────────────────────────────────────────────────────────
# Every Intake email is sent as one of three *roles*. The roles are fixed; the addresses are whatever
# this deployment sets — they are not chosen by the code, and none of them is renamed by it:
#
#   system   → CALDER_FROM_EMAIL                  notices, OTPs, security, receipts (the default voice)
#   team     → CALDER_ANNOUNCEMENT_FROM_EMAIL     launch letters and operator notes ("The Intake Team")
#   personal → CALDER_WELCOME_FROM_EMAIL          the welcome letter ("Daniel from Intake")
#
# A deployment that has been sending from noreply@ keeps sending from noreply@: put that address in
# CALDER_FROM_EMAIL and register it in Calder. Swapping addresses is a decision for the operator, never
# a side effect of a release.
#
# The operator picks one per message in /admin/mail. Nothing is invented at send time: an unset
# address falls back (team → CALDER_FROM_EMAIL, personal → daniel@intake.calder.click), and reply-to is
# always a human.
#
# Every address used here must exist as a sender identity in Calder. Their API accepts a bare address
# it does not know and sends it unattributed — no error, no display name, and missing from that
# sender's stats. `npm run email:doctor` checks all three against GET /v1/senders.
#
# The display NAME below is not sent to Calder — their send API takes a bare address. The name a
# recipient sees comes from the sender identity registered in the Calder dashboard for that address,
# so the two have to agree. Setting the name here only labels the sender inside Intake.
CALDER_ANNOUNCEMENT_FROM_EMAIL=
CALDER_ANNOUNCEMENT_FROM_NAME=The Intake Team
# Where replies to "team" mail land when it should be a person rather than the same inbox.
CALDER_REPLY_TO=
# Where replies to the welcome letter land. Defaults to CALDER_WELCOME_FROM_EMAIL.
CALDER_WELCOME_REPLY_TO=
# Leave unset until the provider actually has a broadcast/campaign route configured. While unset,
# list mail (launch letters, operator notes) is sent as `transactional`, which works today. Setting
# this to true without the route in place fails every list send.
CALDER_BROADCAST_ENABLED=false

TYPEFORM_OAUTH_CLIENT_ID=
TYPEFORM_OAUTH_CLIENT_SECRET=

# ── Google sign-in (identity only; a DIFFERENT Google Cloud client) ──────────────────────────────
# Redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft connection (optional; no Forms creation or editing API exists) ─────────────────────
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT=common       # common | organizations | consumers | tenant GUID

# ── Email ────────────────────────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=none                   # none | calder | memory (memory is a test transport only)
CALDER_API_KEY=
# The "system" sender above. Required unless CALDER_SENDER_ID is set.
CALDER_FROM_EMAIL=
CALDER_FROM_NAME=Intake
# The "personal" sender: the welcome letter, signed by Daniel.
CALDER_WELCOME_FROM_EMAIL=
CALDER_WELCOME_FROM_NAME=Daniel from Intake
# Optional: a Calder sender identity id (send_…) to send from instead of a bare address. A sender id
# is a complete sender on its own; prefer the addresses above so the three-sender model stays readable.
CALDER_SENDER_ID=
# Defaults to https://api.calder.click. Set only to point at a self-hosted Calder.
CALDER_BASE_URL=
CALDER_WEBHOOK_SECRET=

# ── Operators ────────────────────────────────────────────────────────────────────────────────────
# Exact, comma-separated email allowlist for /admin and /api/admin/*. Empty means no operator access.
ADMIN_EMAILS=

# ── Billing ──────────────────────────────────────────────────────────────────────────────────────
# Paid billing stays display-only until a payment provider is deliberately integrated.

# ── Release Manager (GitHub) ───────────────────────────────────────────────────────────────────
# The Release Manager links a changelog draft to a pull request, a commit, a release or a
# deployment, and writes the announcement from what GitHub already knows. Everything here is
# server-side: never add a VITE_ prefix, and never expose the token to the browser.
#
# A fine-grained token with read-only access to the repository is enough. Without these variables
# the Release Manager still works: drafts are written by hand and sources can be linked by URL.
# GITHUB_TOKEN=
# owner/repo, for example Emerald-dev0/Intake.
# GITHUB_REPOSITORY=
# The signing secret of the GitHub webhook that points at ${BETTER_AUTH_URL}/api/webhooks/github.
# Without it the endpoint refuses every delivery.
# GITHUB_WEBHOOK_SECRET=
# Publish an approved release automatically once its linked deployment is observed as successful.
# Off by default: an administrator approves and publishes by hand until the workflow is trusted.
# RELEASE_AUTO_PUBLISH_AFTER_DEPLOYMENT=false
