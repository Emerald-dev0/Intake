{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api(?:/(.*))?$",
      "dest": "${BACKEND_URL}/api/$1",
      "env": ["BACKEND_URL"],
      "headers": { "Cache-Control": "no-store" }
    },
    {
      "src": "/((?:app|admin|auth)(?:/|$).*)",
      "dest": "/private.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "src": "/pricing/?$",
      "dest": "/pricing.html"
    },
    { "handle": "filesystem" },
    {
      "src": "/((?!api(?:/|$)).*)",
      "dest": "/index.html"
    }
  ]
}
